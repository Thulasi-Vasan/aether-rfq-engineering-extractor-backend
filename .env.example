# Copy to .env and fill in. All values are optional except the model id, which
# you should confirm matches a model enabled in your Bedrock account & region.

# --- AWS / Bedrock ---
AWS_REGION=us-east-1
# Confirm this against Bedrock console -> Model access. Bedrock IDs are
# prefixed / inference-profile style and differ from first-party Anthropic IDs.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MAX_TOKENS=16384
# boto3 read timeout in seconds. Detailed plans can run long; default is 300.
# BEDROCK_READ_TIMEOUT_S=300
# Optional: named AWS profile. Leave unset to use the default credential chain.
# AWS_PROFILE=default

# --- CORS ---
# Comma-separated allowed origins. Defaults cover common local frontend ports.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- STEP geometry ---
# g/mm^3. Default 0.0027 = aluminium alloy (~2.7 g/cm^3).
MATERIAL_DENSITY_G_PER_MM3=0.0027

# --- OCC / STEP parsing ---
# Set ENABLE_OCC=false if pythonOCC (cad-occ conda env) is not available.
# ENABLE_OCC=true

# When ENABLE_OCC=false, set USE_STATIC_SUMMARY=true to pass a pre-computed
# STEP feature summary to the LLM instead of skipping STEP context entirely.
# USE_STATIC_SUMMARY=false

# JSON-encoded StepFeatureSummary stored directly here. Only used when
# ENABLE_OCC=false and USE_STATIC_SUMMARY=true.
# Replace the values below with the actual output from summarize_step() for
# your test STEP file (run it once with ENABLE_OCC=true and copy the result).
# STATIC_STEP_SUMMARY={"bounding_box_mm": [150.5, 80.2, 45.1], "volume_mm3": 250000.0, "estimated_weight_kg": 0.675, "num_solids": 1, "num_faces": 42, "num_cylindrical_faces": 12, "num_planar_faces": 25, "num_conical_faces": 2, "num_freeform_faces": 3, "cylinder_radius_histogram_mm": {"5.0": 4, "8.0": 2}}
