# Copy to .env and fill in. All values are optional except the model id, which
# you should confirm matches a model enabled in your Bedrock account & region.

# --- AWS / Bedrock ---
AWS_REGION=us-east-1
# Confirm this against Bedrock console -> Model access. Bedrock IDs are
# prefixed / inference-profile style and differ from first-party Anthropic IDs.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MAX_TOKENS=4096
# Optional: named AWS profile. Leave unset to use the default credential chain.
# AWS_PROFILE=default

# --- CORS ---
# Comma-separated allowed origins. Defaults cover common local frontend ports.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- STEP geometry ---
# g/mm^3. Default 0.0027 = aluminium alloy (~2.7 g/cm^3).
MATERIAL_DENSITY_G_PER_MM3=0.0027
